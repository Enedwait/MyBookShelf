@model MyBookShelf.Shared.Models.Book

@{ ViewData[@ViewKeys.Title] = "Add new book to MyBookShelf!"; }

<h2>@ViewData[@ViewKeys.Title]</h2>
<hr />
<div>
	<form asp-action="@BooksControllerActionNames.Create" method="post">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<div>
			<label asp-for="Title" class="control-label"></label>
			<input asp-for="Title" class="form-control"/>
			<span asp-validation-for="Title" class="text-danger"/>
		</div>
		<div>
			<label asp-for="Author" class="control-label"></label>
			<input asp-for="Author" class="form-control" />
			<span asp-validation-for="Author" class="text-danger"/>
		</div>
		<div>
			<label asp-for="PublishYear" class="control-label"></label>
			<input asp-for="PublishYear" class="form-control" />
			<span asp-validation-for="PublishYear" class="text-danger"/>
		</div>
		<div>
			<label asp-for="Contents" class="control-label"></label>
			<textarea asp-for="Contents" class="form-control" rows="7" ></textarea>
			<span asp-validation-for="Contents" class="text-danger"/>
		</div>
		<hr />
		<div>
			<input type="submit" value="Create" class="btn btn-primary"/>
			<a asp-action="@BooksControllerActionNames.Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>


@section Scripts
{
	@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

